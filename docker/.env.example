# ============================================================
# SERVIQO Docker Environment — DEVELOPMENT DEFAULTS
# Copy this file to docker/.env and adjust values.
# NEVER commit docker/.env to Git.
# ============================================================

# PostgreSQL
POSTGRES_DB=serviqo
POSTGRES_USER=serviqo_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_PORT=5432

# pgAdmin (optional — only used with --profile tools)
PGADMIN_EMAIL=admin@serviqo.local
PGADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
PGADMIN_PORT=5050
